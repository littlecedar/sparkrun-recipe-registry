diff --git a/ds41f-4xgx10-switchless/engine/model/glp.h b/ds41f-4xgx10-switchless/engine/model/glp.h
new file mode 100644
index 0000000..95980fa
--- /dev/null
+++ b/ds41f-4xgx10-switchless/engine/model/glp.h
@@ -0,0 +1,340 @@
+// GLP steering vectors (github.com/msuiche/weightless, spec docs/spec/GLP.md): one unit direction per
+// model layer, projected out of the residual stream — h <- h - alpha * (h . d) d — for requests that ask
+// for the steered served name. No weights are modified.
+//
+// Host-only and CUDA-free on purpose: the same reader runs in the engine's start-up and in the host-only
+// test (engine/model/tests/glp_test.cu), so a file this runtime cannot apply exactly is refused before a
+// boot rather than served unsteered or steered at another site. It mirrors the reference reader,
+// vllm/models/deepseek_v4_1/glp.py in christopherowen/spark-ds41f.
+//
+// The vector applies at residual_stream_post_layer: layer N's write folded into the hyper-connection
+// streams, before layer N+1 reads Engram. direction.N is applied after layer N (no offset), for
+// 1 <= N < num_layers; direction.0 cannot be expressed. Every hc copy is projected with the same
+// direction, so their mean — the quantity the direction was derived on — is projected too.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace model::glp {
+
+// The spec version and hook this reader implements; another value is a file for a different runtime.
+constexpr int kSpecVersion = 1;
+constexpr const char* kHookPoint = "residual_stream_post_layer";
+// A direction's norm may differ from 1 by float32 export rounding, no more.
+constexpr double kUnitNormTolerance = 1e-3;
+
+struct Glp {
+  int layers = 0;          // the model's layer count the file was checked against
+  int dim = 0;             // hidden size
+  float alpha = 0.f;       // the projection's strength
+  uint64_t mask = 0;       // bit L set: layer L is steered (64 bits: kLayers is 40)
+  std::vector<float> dir;  // [layers][dim]; an unsteered layer's row is zero
+
+  bool any() const { return mask != 0; }
+  bool steered(int L) const { return L >= 0 && L < layers && (mask >> L & 1ull) != 0; }
+  const float* at(int L) const { return dir.data() + (size_t)L * dim; }
+};
+
+namespace detail {
+
+// One cursor over the file's bytes; every read is bounds-checked and a short read is a refusal.
+struct Cursor {
+  const uint8_t* p;
+  size_t n, i = 0;
+  Cursor(const uint8_t* b, size_t len) : p(b), n(len) {}
+  const uint8_t* bytes(size_t k) {
+    if (i + k > n) throw std::runtime_error("truncated GGUF");
+    const uint8_t* r = p + i;
+    i += k;
+    return r;
+  }
+  template <class T>
+  T get() {
+    const uint8_t* b = bytes(sizeof(T));
+    T v;
+    std::memcpy(&v, b, sizeof(T));
+    return v;
+  }
+  std::string str() {
+    const uint64_t len = get<uint64_t>();
+    if (len > n - i) throw std::runtime_error("truncated GGUF string");
+    const uint8_t* b = bytes((size_t)len);
+    return std::string(reinterpret_cast<const char*>(b), (size_t)len);
+  }
+};
+
+// A GGUF metadata value. Only the kinds this reader accepts are represented; anything else is refused.
+struct Value {
+  uint32_t kind = 0;
+  uint64_t u = 0;
+  int64_t s = 0;
+  double f = 0;
+  bool b = false;
+  std::string str;
+  std::vector<Value> arr;
+};
+
+inline Value read_kind(Cursor& c, uint32_t kind, int depth);
+
+inline Value read_value(Cursor& c, int depth) { return read_kind(c, c.get<uint32_t>(), depth); }
+
+inline Value read_kind(Cursor& c, uint32_t kind, int depth) {
+  Value v;
+  v.kind = kind;
+  switch (kind) {
+    case 0: v.u = c.get<uint8_t>(); break;
+    case 1: v.s = c.get<int8_t>(); break;
+    case 2: v.u = c.get<uint16_t>(); break;
+    case 3: v.s = c.get<int16_t>(); break;
+    case 4: v.u = c.get<uint32_t>(); break;
+    case 5: v.s = c.get<int32_t>(); break;
+    case 6: v.f = c.get<float>(); break;
+    case 7: v.b = c.get<uint8_t>() != 0; break;
+    case 8: v.str = c.str(); break;
+    case 9: {
+      if (depth > 0) throw std::runtime_error("nested GGUF arrays are not supported");
+      const uint32_t item = c.get<uint32_t>();
+      if (item == 9) throw std::runtime_error("nested GGUF arrays are not supported");
+      const uint64_t count = c.get<uint64_t>();
+      if (count > (uint64_t)1 << 20) throw std::runtime_error("GGUF array is too long");
+      v.arr.reserve((size_t)count);
+      for (uint64_t k = 0; k < count; ++k) v.arr.push_back(read_kind(c, item, depth + 1));
+      break;
+    }
+    case 10: v.u = c.get<uint64_t>(); break;
+    case 11: v.s = c.get<int64_t>(); break;
+    case 12: v.f = c.get<double>(); break;
+    default: throw std::runtime_error("unknown GGUF value type " + std::to_string(kind));
+  }
+  return v;
+}
+
+struct TensorInfo {
+  std::string name;
+  std::vector<uint64_t> dims;
+  uint32_t kind = 0;
+  uint64_t offset = 0;
+};
+
+struct Gguf {
+  std::map<std::string, Value> meta;
+  std::vector<TensorInfo> tensors;
+  std::vector<uint8_t> data;  // the whole file, kept: the tensors point into it
+  size_t base = 0;            // where the tensor data starts
+
+  const Value* find(const char* key) const {
+    const auto it = meta.find(key);
+    return it == meta.end() ? nullptr : &it->second;
+  }
+};
+
+// GGUF v3, little-endian, flat metadata, 1-D F32 tensors only; anything else, and any byte past the last
+// tensor's alignment, is refused.
+inline Gguf read_gguf(const std::string& path) {
+  FILE* f = std::fopen(path.c_str(), "rb");
+  if (!f) throw std::runtime_error("cannot open " + path);
+  Gguf g;
+  if (std::fseek(f, 0, SEEK_END) != 0) {
+    std::fclose(f);
+    throw std::runtime_error("cannot seek " + path);
+  }
+  const long size = std::ftell(f);
+  std::rewind(f);
+  if (size <= 0) {
+    std::fclose(f);
+    throw std::runtime_error("empty file " + path);
+  }
+  g.data.resize((size_t)size);
+  const size_t got = std::fread(g.data.data(), 1, g.data.size(), f);
+  std::fclose(f);
+  if (got != g.data.size()) throw std::runtime_error("short read " + path);
+
+  Cursor c(g.data.data(), g.data.size());
+  const uint8_t* magic = c.bytes(4);
+  if (std::memcmp(magic, "GGUF", 4) != 0) throw std::runtime_error(path + ": not a GGUF file");
+  const uint32_t version = c.get<uint32_t>();
+  if (version != 3) throw std::runtime_error(path + ": GGUF version " + std::to_string(version) + ", expected 3");
+  const uint64_t n_tensors = c.get<uint64_t>();
+  const uint64_t n_keys = c.get<uint64_t>();
+  if (n_tensors > 4096 || n_keys > 4096) throw std::runtime_error(path + ": implausible GGUF header");
+  for (uint64_t k = 0; k < n_keys; ++k) {
+    const std::string key = c.str();
+    if (g.meta.count(key)) throw std::runtime_error(path + ": duplicate GGUF key " + key);
+    g.meta.emplace(key, read_value(c, 0));
+  }
+  for (uint64_t k = 0; k < n_tensors; ++k) {
+    TensorInfo t;
+    t.name = c.str();
+    const uint32_t n_dims = c.get<uint32_t>();
+    if (n_dims < 1 || n_dims > 4) throw std::runtime_error(path + ": tensor " + t.name + " has a bad rank");
+    for (uint32_t d = 0; d < n_dims; ++d) t.dims.push_back(c.get<uint64_t>());
+    t.kind = c.get<uint32_t>();
+    t.offset = c.get<uint64_t>();
+    if (t.kind != 0) throw std::runtime_error(path + ": tensor " + t.name + " is GGML type " + std::to_string(t.kind) + ", not F32");
+    if (t.dims.size() != 1) throw std::runtime_error(path + ": tensor " + t.name + " is not 1-D");
+    g.tensors.push_back(std::move(t));
+  }
+  uint64_t alignment = 32;
+  if (const Value* a = g.find("general.alignment")) {
+    if (a->kind != 4 || a->u == 0) throw std::runtime_error(path + ": general.alignment is not a positive integer");
+    alignment = a->u;
+  }
+  g.base = (size_t)((c.i + alignment - 1) / alignment * alignment);
+  size_t end = g.base;
+  for (const TensorInfo& t : g.tensors) {
+    const size_t start = g.base + (size_t)t.offset;
+    const size_t bytes = (size_t)t.dims[0] * 4;
+    if (start % alignment || start + bytes > g.data.size())
+      throw std::runtime_error(path + ": tensor " + t.name + " lies outside the file");
+    end = std::max(end, start + bytes);
+  }
+  if (g.data.size() - end >= alignment) throw std::runtime_error(path + ": " + std::to_string(g.data.size() - end) + " unexpected bytes after the last tensor");
+  return g;
+}
+
+inline std::vector<int> parse_layer_list(const std::string& text) {
+  std::vector<int> out;
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && (text[i] == ' ' || text[i] == ',')) ++i;
+    if (i >= text.size()) break;
+    int v = 0;
+    bool any = false;
+    while (i < text.size() && text[i] >= '0' && text[i] <= '9') {
+      v = v * 10 + (text[i] - '0');
+      any = true;
+      ++i;
+    }
+    if (!any) throw std::runtime_error("not a comma list of layer ids");
+    if (i + 1 < text.size() && text[i] == '-' && text[i + 1] >= '0' && text[i + 1] <= '9') {
+      ++i;
+      int e = 0;
+      while (i < text.size() && text[i] >= '0' && text[i] <= '9') e = e * 10 + (text[i++] - '0');
+      if (e < v || e - v > 4096) throw std::runtime_error("bad layer range");
+      for (int x = v; x <= e; ++x) out.push_back(x);
+      continue;
+    }
+    out.push_back(v);
+  }
+  std::sort(out.begin(), out.end());
+  return out;
+}
+
+}  // namespace detail
+
+// The file's directions, checked against the model it will steer. Throws std::runtime_error naming the
+// refusal; the caller stops the boot.
+inline Glp read(const std::string& path, int num_layers, int hidden_size) {
+  detail::Gguf g = detail::read_gguf(path);
+  const auto need_str = [&](const char* key) -> std::string {
+    const detail::Value* v = g.find(key);
+    if (!v || v->kind != 8) throw std::runtime_error(path + ": " + key + " is missing or not a string");
+    return v->str;
+  };
+  const auto need_int = [&](const char* key) -> int64_t {
+    const detail::Value* v = g.find(key);
+    if (!v || (v->kind != 4 && v->kind != 5 && v->kind != 10 && v->kind != 11))
+      throw std::runtime_error(path + ": " + key + " is missing or not an integer");
+    return v->kind == 4 || v->kind == 10 ? (int64_t)v->u : v->s;
+  };
+  if (const detail::Value* mode = g.find("glp.mode")) {
+    if (mode->kind != 8 || mode->str != "project")
+      throw std::runtime_error(path + ": glp.mode is not 'project'; this runtime projects and never adds a control vector");
+  } else {
+    throw std::runtime_error(path + ": no glp.mode (an absent mode means 'add')");
+  }
+  if (need_int("glp.spec_version") != kSpecVersion)
+    throw std::runtime_error(path + ": glp.spec_version is not " + std::to_string(kSpecVersion) + " (rank 1, no alpha scaling keys)");
+  if (g.find("glp.rank") && need_int("glp.rank") != 1) throw std::runtime_error(path + ": glp.rank is not 1");
+  if (need_str("glp.hook_point") != kHookPoint)
+    throw std::runtime_error(path + ": glp.hook_point is not " + std::string(kHookPoint) + "; this runtime applies at that site only");
+
+  Glp out;
+  out.layers = num_layers;
+  out.dim = hidden_size;
+  out.dir.assign((size_t)num_layers * (size_t)hidden_size, 0.f);
+  std::vector<int> layers;
+  for (const detail::TensorInfo& t : g.tensors) {
+    const std::string prefix = "direction.";
+    if (t.name.compare(0, prefix.size(), prefix) != 0)
+      throw std::runtime_error(path + ": tensor " + t.name + " is not a direction.<layer>");
+    const std::string digits = t.name.substr(prefix.size());
+    if (digits.empty()) throw std::runtime_error(path + ": tensor " + t.name + " is not a direction.<layer>");
+    int layer = 0;
+    for (const char ch : digits) {
+      if (ch < '0' || ch > '9') throw std::runtime_error(path + ": tensor " + t.name + " is not a direction.<layer>");
+      layer = layer * 10 + (ch - '0');
+    }
+    if (layer < 1 || layer >= num_layers)
+      throw std::runtime_error(path + ": " + t.name + " is outside layers 1.." + std::to_string(num_layers - 1) + " (direction.0 cannot be expressed)");
+    if ((int)t.dims[0] != hidden_size)
+      throw std::runtime_error(path + ": " + t.name + " has width " + std::to_string(t.dims[0]) + ", not " + std::to_string(hidden_size));
+    const float* src = reinterpret_cast<const float*>(g.data.data() + g.base + (size_t)t.offset);
+    double sum = 0.0;
+    for (int c = 0; c < hidden_size; ++c) {
+      if (!std::isfinite(src[c])) throw std::runtime_error(path + ": " + t.name + " is not finite");
+      sum += (double)src[c] * (double)src[c];
+    }
+    const double norm = std::sqrt(sum);
+    if (std::fabs(norm - 1.0) > kUnitNormTolerance)
+      throw std::runtime_error(path + ": " + t.name + " has norm " + std::to_string(norm) + ", not 1");
+    const float scale = (float)(1.0 / norm);
+    for (int c = 0; c < hidden_size; ++c) out.dir[(size_t)layer * hidden_size + c] = src[c] * scale;
+    out.mask |= 1ull << layer;
+    layers.push_back(layer);
+  }
+  if (layers.empty()) throw std::runtime_error(path + ": no direction tensors");
+  if (const detail::Value* declared = g.find("glp.layer_ids_zero_based")) {
+    if (declared->kind != 8) throw std::runtime_error(path + ": glp.layer_ids_zero_based is not a string");
+    if (detail::parse_layer_list(declared->str) != layers)
+      throw std::runtime_error(path + ": glp.layer_ids_zero_based disagrees with the direction tensors; re-export the file");
+  }
+  out.alpha = 0.75f;
+  if (const detail::Value* a = g.find("glp.alpha_default")) {
+    if (a->kind != 6 || !std::isfinite((double)a->f)) throw std::runtime_error(path + ": glp.alpha_default is not a finite float");
+    out.alpha = (float)a->f;
+  }
+  return out;
+}
+
+// WEIGHTLESS_STEER_LAYERS: restrict the vector to the layers named ("1,2,3" or "1-39"). A layer the file
+// has no direction for is a refusal, not a silent skip.
+inline void restrict_layers(Glp& g, const std::string& text) {
+  const std::vector<int> keep = detail::parse_layer_list(text);
+  if (keep.empty()) throw std::runtime_error("WEIGHTLESS_STEER_LAYERS names no layer");
+  uint64_t mask = 0;
+  for (const int L : keep) {
+    if (L < 0 || L >= g.layers || !g.steered(L))
+      throw std::runtime_error("WEIGHTLESS_STEER_LAYERS names layer " + std::to_string(L) + ", which has no direction");
+    mask |= 1ull << L;
+  }
+  g.mask = mask;
+}
+
+// The kernel's arithmetic, on the host: h <- h - alpha * (h . d) d, fp32, one hc copy of `dim` floats.
+// alpha == 0 is exactly the identity (h - 0 * x == h in IEEE fp32, and bf16 -> fp32 -> bf16 is exact).
+inline void steer_row_ref(float* h, const float* d, float alpha, int dim) {
+  float s = 0.f;
+  for (int c = 0; c < dim; ++c) s = std::fma(h[c], d[c], s);
+  const float k = alpha * s;
+  for (int c = 0; c < dim; ++c) h[c] -= k * d[c];
+}
+
+// One line for the start-up log: what was loaded, or that nothing was.
+inline std::string describe(const Glp& g) {
+  if (!g.any()) return "none";
+  std::string s = std::to_string(__builtin_popcountll(g.mask)) + " directions, layers";
+  for (int L = 0; L < g.layers; ++L)
+    if (g.steered(L)) s += " " + std::to_string(L);
+  s += ", alpha " + std::to_string(g.alpha) + ", dim " + std::to_string(g.dim);
+  return s;
+}
