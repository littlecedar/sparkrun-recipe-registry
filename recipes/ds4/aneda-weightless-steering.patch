+// GLP steering (model/glp.h): one block per row, the four copies one after another, each a 5120 dot summed
+// by block_sum's fixed order and then h = bf16(h - alpha * (h . d) d). x_in may be x: every element is read
+// by the thread that writes it, after the dot has read it.
+__global__ void k_steer_rows(const bf16* x_in, const bf16* dir, float alpha, bf16* x, const int32_t* steer) {
+  __shared__ float red[32];
+  const int r = blockIdx.x;
+  if (steer && steer[r] == 0) return;
+  const size_t base = (size_t)r * kHcDim;
+  for (int c = 0; c < kHc; ++c) {
+    const size_t o = base + (size_t)c * kDim;
+    float dot = 0.f;
+    for (int i = threadIdx.x; i < kDim; i += blockDim.x)
+      dot = fmaf(__bfloat162float(x_in[o + i]), __bfloat162float(dir[i]), dot);
+    dot = block_sum(dot, red);
+    for (int i = threadIdx.x; i < kDim; i += blockDim.x) {
+      const float h = __bfloat162float(x_in[o + i]);
+      x[o + i] = __float2bfloat16(h - alpha * dot * __bfloat162float(dir[i]));
+    }
+  }
+}
+
+void steer_rows(bf16* x, const bf16* dir, float alpha, int R, const int32_t* steer, cudaStream_t s) {
+  if (R <= 0) return;
+  k_steer_rows<<<R, 256, 0, s>>>(x, dir, alpha, x, steer);
+  CUDA_CHECK(cudaGetLastError());
+}
