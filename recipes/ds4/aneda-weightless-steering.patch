+        let p1 = "<｜System｜>You are a careful assistant who answers briefly and well.<｜User｜>hello<｜Assistant｜></think>";
+        let (stock, _) = t.plan(p1, false, &tok, 1);
+        t.finish(stock.session_id, p1, &stock.ids, &tok.encode("Hi there."), &tok);
+        let p2 = format!("{p1}Hi there.<｜User｜>next<｜Assistant｜></think>");
+        let (steered, _) = t.plan(&p2, true, &tok, 1);
+        assert_ne!(steered.session_id, stock.session_id, "a steered request must not continue the stock session");
+        assert_eq!((steered.reused, steered.common), (0, 0), "nothing of another stream's KV is taken");
+        // the same prompt on the stock name still finds its own session, in place
+        let (again, _) = t.plan(&p2, false, &tok, 1);
+        assert_eq!(again.session_id, stock.session_id);
+        assert!(again.reused > 0);
+        // and the flag is written and read back: a reloaded steered session is steered
+        let dir = std::env::temp_dir().join(format!("dsfront-steer-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir(&dir).unwrap();
+        let path = dir.join("front.table");
+        t.finish(steered.session_id, &p2, &steered.ids, &tok.encode("Sure."), &tok);
+        assert_eq!(t.save(&path, 3600), Ok(2));
+        let mut u = SessionTable::new(8, 1 << 20);
+        assert_eq!(u.load(&path, &tok, 3600), Ok(2));
+        let p3 = format!("{p2}Sure.</think>thanks</think>");
+        let (stock3, _) = u.plan(&p3, false, &tok, 1);
+        assert_eq!(stock3.session_id, stock.session_id);
+        let (steered3, _) = u.plan(&p3, true, &tok, 1);
+        assert_eq!(steered3.session_id, steered.session_id, "the loaded table kept the flag");
+        assert!(steered3.reused > 0);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
