+// Host-only checks for engine/model/glp.h (no CUDA, no GPU): the reader's refusals, the real file's
+// shape, and the projection's arithmetic — including that alpha = 0 is exactly the identity.
+//
+//   g++ -std=c++17 -O2 -I engine -x c++ engine/model/tests/glp_test.cu -o /tmp/glp_test
+//   /tmp/glp_test [path/to/vector.gguf]
+//
+// The CMake target glp_test builds the same file with nvcc on a GB10 host; nothing here needs a device.
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "model/glp.h"
+
+namespace {
+
+int g_fail = 0, g_checks = 0;
+
+void check(bool ok, const std::string& what) {
+  ++g_checks;
+  if (!ok) {
+    ++g_fail;
+    std::printf("FAIL %s\n", what.c_str());
+  }
+}
+
+struct Buf {
+  std::vector<uint8_t> b;
+  template <class T>
+  void put(T v) {
+    const uint8_t* p = reinterpret_cast<const uint8_t*>(&v);
+    b.insert(b.end(), p, p + sizeof(T));
+  }
+  void str(const std::string& s) {
+    put<uint64_t>(s.size());
+    b.insert(b.end(), s.begin(), s.end());
+  }
+};
+
+void meta_str(Buf& f, const char* k, const std::string& v) {
+  f.str(k);
+  f.put<uint32_t>(8);
+  f.str(v);
+}
+void meta_int(Buf& f, const char* k, int64_t v) {
+  f.str(k);
+  f.put<uint32_t>(11);
+  f.put<int64_t>(v);
+}
+void meta_f32(Buf& f, const char* k, float v) {
+  f.str(k);
+  f.put<uint32_t>(6);
+  f.put<float>(v);
+}
+
+// A GGUF v3 file with one direction.<layer> per entry. Everything the reader checks is a parameter, so a
+// negative control is one argument away.
+std::vector<uint8_t> build(int n_dirs, int dim, const std::string& mode, int64_t spec, int64_t rank,
+                           const std::string& hook, const std::string& layer_list, float norm_scale,
+                           bool trailing, bool width_off) {
+  Buf f;
+  f.b.insert(f.b.end(), {'G', 'G', 'U', 'F'});
+  f.put<uint32_t>(3);
+  f.put<uint64_t>((uint64_t)n_dirs);
+  f.put<uint64_t>(7);
+  meta_str(f, "general.architecture", "controlvector");
+  meta_str(f, "glp.mode", mode);
+  meta_int(f, "glp.spec_version", spec);
+  meta_int(f, "glp.rank", rank);
+  meta_str(f, "glp.hook_point", hook);
+  meta_str(f, "glp.layer_ids_zero_based", layer_list);
+  meta_f32(f, "glp.alpha_default", 0.75f);
+  // A second pass would be needed for alignment, so fix the tensor offsets after the header is written:
+  // every tensor is dim floats, offsets are relative to the aligned data base.
+  std::vector<std::pair<std::string, uint64_t>> tensors;
+  for (int i = 0; i < n_dirs; ++i) {
+    const std::string name = "direction." + std::to_string(i + 1);
+    f.str(name);
+    f.put<uint32_t>(1);
+    f.put<uint64_t>((uint64_t)(width_off && i == 0 ? dim + 1 : dim));
+    f.put<uint32_t>(0);  // F32
+    f.put<uint64_t>((uint64_t)i * (uint64_t)dim * 4);
+    tensors.emplace_back(name, (uint64_t)i);
+  }
+  while (f.b.size() % 32) f.b.push_back(0);
+  for (int i = 0; i < n_dirs; ++i) {
+    std::vector<float> v((size_t)dim, 0.f);
+    // an orthonormal-ish direction: e_i on the first axis plus a small deterministic tail
+    for (int c = 0; c < dim; ++c) v[(size_t)c] = (c == i % dim ? 1.f : 0.f) + 0.001f * (float)((c * 7 + i) % 5);
+    double s = 0.0;
+    for (float x : v) s += (double)x * x;
+    const double n = std::sqrt(s);
+    for (float& x : v) x = (float)(x / n * norm_scale);
+    const uint8_t* p = reinterpret_cast<const uint8_t*>(v.data());
+    f.b.insert(f.b.end(), p, p + v.size() * 4);
+  }
+  if (trailing) f.b.insert(f.b.end(), 64, 0x5a);  // >= alignment of bytes past the last tensor
+  return f.b;
+}
+
+std::string write_tmp(const std::vector<uint8_t>& bytes, const char* tag) {
+  const std::string path = std::string("/tmp/glp_test_") + tag + ".gguf";
+  FILE* fp = std::fopen(path.c_str(), "wb");
+  if (!fp) return {};
+  std::fwrite(bytes.data(), 1, bytes.size(), fp);
+  std::fclose(fp);
+  return path;
+}
+
+bool refuses(const std::vector<uint8_t>& bytes, const char* tag, int num_layers, int dim, std::string* why = nullptr) {
+  const std::string path = write_tmp(bytes, tag);
+  if (path.empty()) return false;
+  try {
+    (void)model::glp::read(path, num_layers, dim);
+  } catch (const std::exception& e) {
+    if (why) *why = e.what();
+    std::remove(path.c_str());
+    return true;
+  }
+  std::remove(path.c_str());
+  return false;
+}
+
+// bf16 round-trip, as the kernel sees the stream (bf16 in, bf16 out).
+float bf16_round(float v) {
+  uint32_t bits;
+  std::memcpy(&bits, &v, 4);
+  const uint32_t round = 0x7fffu + ((bits >> 16) & 1u);
+  bits = (bits + round) & 0xffff0000u;
+  float out;
+  std::memcpy(&out, &bits, 4);
+  return out;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  const int dim = 8, layers = 4;
+  const std::string list = "1,2,3";
+
+  // A good file reads.
+  {
+    const std::string path = write_tmp(build(3, dim, "project", 1, 1, "residual_stream_post_layer", list, 1.f, false, false), "good");
+    const model::glp::Glp g = model::glp::read(path, layers, dim);
+    check(g.layers == layers && g.dim == dim, "good: shape");
+    check(g.mask == 0b1110ull && g.steered(1) && g.steered(3) && !g.steered(0), "good: layers 1..3, not 0");
+    check(g.alpha == 0.75f, "good: alpha_default");
+    double n = 0.0;
+    for (int c = 0; c < dim; ++c) n += (double)g.at(1)[c] * (double)g.at(1)[c];
+    check(std::fabs(std::sqrt(n) - 1.0) < 1e-6, "good: direction is unit norm");
+    std::remove(path.c_str());
+  }
+
+  // The ten refusals the plan names.
+  {
+    std::vector<uint8_t> b = build(3, dim, "project", 1, 1, "residual_stream_post_layer", list, 1.f, false, false);
+    b.resize(b.size() - 12);  // truncated mid-tensor
+    check(refuses(b, "trunc", layers, dim), "refuse: truncated file");
+  }
+  check(refuses(build(3, dim, "project", 1, 1, "residual_stream_post_layer", "0,2,3", 1.f, false, false), "dir0", layers, dim),
+        "refuse: direction.0");
+  check(refuses(build(4, dim, "project", 1, 1, "residual_stream_post_layer", "1,2,3,4", 1.f, false, false), "dir40", layers, dim),
+        "refuse: layer >= num_layers");
+  check(refuses(build(3, dim, "project", 1, 1, "residual_stream_post_layer", list, 1.f, false, true), "width", layers, dim),
+        "refuse: width != hidden_size");
+  check(refuses(build(3, dim, "project", 1, 1, "residual_stream_post_layer", list, 1.01f, false, false), "norm", layers, dim),
+        "refuse: norm not 1");
+  check(refuses(build(3, dim, "add", 1, 1, "residual_stream_post_layer", list, 1.f, false, false), "mode", layers, dim),
+        "refuse: glp.mode is add");
+  check(refuses(build(3, dim, "project", 2, 1, "residual_stream_post_layer", list, 1.f, false, false), "spec", layers, dim),
+        "refuse: spec_version 2");
+  check(refuses(build(3, dim, "project", 1, 2, "residual_stream_post_layer", list, 1.f, false, false), "rank", layers, dim),
+        "refuse: rank 2");
+  check(refuses(build(3, dim, "project", 1, 1, "ffn_out_pre_residual", list, 1.f, false, false), "hook", layers, dim),
+        "refuse: another hook point");
+  check(refuses(build(3, dim, "project", 1, 1, "residual_stream_post_layer", "1,2", 1.f, false, false), "list", layers, dim),
+        "refuse: layer_ids_zero_based disagrees");
+  check(refuses(build(3, dim, "project", 1, 1, "residual_stream_post_layer", list, 1.f, true, false), "trail", layers, dim),
+        "refuse: bytes past the last tensor");
+
+  // The projection: alpha = 0 is exactly the identity on a bf16 stream; alpha > 0 removes (1 - alpha) of
+  // the component along d and leaves the rest.
+  {
+    const int n = 64;
+    std::vector<float> d((size_t)dim), h((size_t)dim), h0((size_t)dim);
+    double s = 0.0;
+    for (int c = 0; c < dim; ++c) d[(size_t)c] = 1.f + 0.1f * (float)c;
+    for (float& x : d) s += (double)x * x;
+    for (float& x : d) x = (float)(x / std::sqrt(s));
+    for (int r = 0; r < n; ++r) {
+      for (int c = 0; c < dim; ++c) h[(size_t)c] = h0[(size_t)c] = bf16_round(std::sin(0.37f * (float)(r * dim + c)) * 3.f);
+      model::glp::steer_row_ref(h.data(), d.data(), 0.f, dim);
+      check(std::memcmp(h.data(), h0.data(), sizeof(float) * (size_t)dim) == 0, "alpha 0: bit-exact identity");
+    }
+    for (int c = 0; c < dim; ++c) h[(size_t)c] = h0[(size_t)c] = bf16_round(std::cos(0.11f * (float)c) * 2.f);
+    float before = 0.f;
+    for (int c = 0; c < dim; ++c) before += h0[(size_t)c] * d[(size_t)c];
+    model::glp::steer_row_ref(h.data(), d.data(), 0.75f, dim);
+    float after = 0.f;
+    for (int c = 0; c < dim; ++c) after += h[(size_t)c] * d[(size_t)c];
+    check(std::fabs(after - 0.25f * before) < 1e-4f, "alpha 0.75: leaves 1-alpha of the projection");
+  }
+
+  // The real vector, when one is given: its published shape, and the identity gate on its own directions.
+  if (argc > 1) {
+    try {
+      const model::glp::Glp g = model::glp::read(argv[1], 40, 5120);
+      check(g.mask == 0xfffffffffeull, "real file: layers 1..39");
+      check(g.alpha == 0.75f, "real file: alpha 0.75");
+      check(g.dim == 5120 && g.layers == 40, "real file: 40 layers, hidden 5120");
+      std::vector<float> h((size_t)5120), h0((size_t)5120);
+      for (int c = 0; c < 5120; ++c) h[(size_t)c] = h0[(size_t)c] = bf16_round(std::sin(0.001f * (float)c) * 4.f);
+      model::glp::steer_row_ref(h.data(), g.at(20), 0.f, 5120);
+      check(std::memcmp(h.data(), h0.data(), sizeof(float) * 5120) == 0, "real file: alpha 0 identity on direction.20");
+      std::printf("real file: %s\n", model::glp::describe(g).c_str());
+    } catch (const std::exception& e) {
+      check(false, std::string("real file: ") + e.what());
+    }
+  }
+
+  std::printf("%d checks, %d failed\n", g_checks, g_fail);
+  return g_fail == 0 ? 0 : 1;
+}
