diff --git a/ds41f-4xgx10-switchless/engine/common/log.h b/ds41f-4xgx10-switchless/engine/common/log.h
new file mode 100644
index 0000000..c283938
--- /dev/null
+++ b/ds41f-4xgx10-switchless/engine/common/log.h
@@ -0,0 +1,157 @@
+// Structured log records, one line per event. The grammar is shared with the front-end (frontend/src/log.rs):
+//   ts=<UTC ISO-8601 with milliseconds> level=<debug|info|warn|error|fatal> node=<host> rank=<0-3>
+//   src=engine event=<noun.verb> [key=value]... [msg="<text>"]
+// A record is built in one stack buffer and written with one fwrite: the request path allocates nothing.
+// DSGB10_LOG_LEVEL gates the records (debug < info < warn < error < fatal; default info): a call below
+// the threshold returns after one int compare.
+#pragma once
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <time.h>
+#include <unistd.h>
+
+namespace lg {
+
+// The levels, in gate order.
+enum Level : int { kDebug = 0, kInfo, kWarn, kError, kFatal };
+
+inline const char* level_name(Level l) {
+  switch (l) {
+    case kDebug: return "debug";
+    case kWarn: return "warn";
+    case kError: return "error";
+    case kFatal: return "fatal";
+    default: return "info";
+  }
+}
+
+inline int level_value(const char* s) {
+  if (std::strcmp(s, "debug") == 0) return kDebug;
+  if (std::strcmp(s, "info") == 0) return kInfo;
+  if (std::strcmp(s, "warn") == 0) return kWarn;
+  if (std::strcmp(s, "error") == 0) return kError;
+  if (std::strcmp(s, "fatal") == 0) return kFatal;
+  return -1;
+}
+
+// The rank a record names when its call site holds no Model (check.h's die, the reader thread). main()
+// sets it from the rank it was started with.
+inline int& rank_ref() {
+  static int r = 0;
+  return r;
+}
+inline void set_rank(int r) { rank_ref() = r; }
+
+inline const char* node() {
+  static char h[256];
+  static const bool once = [] {
+    if (gethostname(h, sizeof h - 1) != 0) std::snprintf(h, sizeof h, "unknown");
+    return true;
+  }();
+  (void)once;
+  return h;
+}
+
+// The prefix, then tail as the caller built it (key=value fields, or msg="..." last), then a newline.
+inline void emit(int rank, Level level, const char* event, const char* tail) {
+  timespec ts{};
+  clock_gettime(CLOCK_REALTIME, &ts);
+  std::tm t{};
+  gmtime_r(&ts.tv_sec, &t);
+  char b[8192];
+  std::snprintf(b, sizeof b, "ts=%04d-%02d-%02dT%02d:%02d:%02d.%03ldZ level=%s node=%s rank=%d src=engine event=%s",
+                t.tm_year + 1900, t.tm_mon + 1, t.tm_mday, t.tm_hour, t.tm_min, t.tm_sec, ts.tv_nsec / 1000000,
+                level_name(level), node(), rank, event);
+  size_t n = std::strlen(b);
+  if (tail && *tail) {
+    std::snprintf(b + n, sizeof b - n, " %s", tail);
+    n = std::strlen(b);
+  }
+  if (n < sizeof b - 1) b[n++] = '\n';
+  std::fwrite(b, 1, n, stdout);  // line-buffered stdout (main sets _IOLBF): one write
+}
+
+// The threshold, resolved once from DSGB10_LOG_LEVEL (default info). An unknown value falls back to
+// info and writes one warn record naming it, so a bad setting is visible, not silent.
+inline int threshold() {
+  static const int t = [] {
+    const char* e = std::getenv("DSGB10_LOG_LEVEL");
+    const int v = e && *e ? level_value(e) : int(kInfo);
+    if (v >= 0) return v;
+    char tail[256];
+    std::snprintf(tail, sizeof tail, "value=%s msg=\"unknown DSGB10_LOG_LEVEL, using info\"", e);
+    emit(rank_ref(), kWarn, "log.level", tail);
+    return int(kInfo);
+  }();
+  return t;
+}
+inline bool on(Level level) { return int(level) >= threshold(); }
+
+inline void vline(int rank, Level level, const char* event, const char* fmt, va_list ap) {
+  if (!on(level)) return;
+  char tail[4096];
+  std::vsnprintf(tail, sizeof tail, fmt, ap);
+  emit(rank, level, event, tail);
+}
+
+// key=value fields (fmt is the tail as the grammar defines it).
+inline void line(int rank, Level level, const char* event, const char* fmt, ...) {
+  va_list ap;
+  va_start(ap, fmt);
+  vline(rank, level, event, fmt, ap);
+  va_end(ap);
+}
+inline void log_line(Level level, const char* event, const char* fmt, ...) {
+  va_list ap;
+  va_start(ap, fmt);
+  vline(rank_ref(), level, event, fmt, ap);
+  va_end(ap);
+}
+
+// msg="..." with quotes, backslashes and control characters escaped, for a tail a caller builds itself.
+inline const char* quote(char* dst, size_t n, const char* text) {
+  size_t j = 0;
+  dst[j++] = '"';
+  for (const char* p = text; *p && j + 8 < n; ++p) {
+    const unsigned char c = (unsigned char)*p;
+    if (c == '"' || c == '\\') dst[j++] = '\\', dst[j++] = (char)c;
+    else if (c == '\n') dst[j++] = '\\', dst[j++] = 'n';
+    else if (c == '\t') dst[j++] = '\\', dst[j++] = 't';
+    else if (c == '\r') dst[j++] = '\\', dst[j++] = 'r';
+    else dst[j++] = (char)c;
+  }
+  dst[j++] = '"';
+  dst[j] = 0;
+  return dst;
+}
+
+inline void msg_at(int rank, Level level, const char* event, const char* text) {
+  if (!on(level)) return;
+  char q[4100];
+  std::memcpy(q, "msg=", 4);
+  quote(q + 4, sizeof q - 4, text);
+  emit(rank, level, event, q);
+}
+inline void log_msg_at(int rank, Level level, const char* event, const char* fmt, ...) {
+  if (!on(level)) return;
+  char text[4000];
+  va_list ap;
+  va_start(ap, fmt);
+  std::vsnprintf(text, sizeof text, fmt, ap);
+  va_end(ap);
+  msg_at(rank, level, event, text);
+}
+inline void log_msg(Level level, const char* event, const char* fmt, ...) {
+  if (!on(level)) return;
+  char text[4000];
+  va_list ap;
+  va_start(ap, fmt);
+  std::vsnprintf(text, sizeof text, fmt, ap);
+  va_end(ap);
+  msg_at(rank_ref(), level, event, text);
+}
+
+}  // namespace lg
