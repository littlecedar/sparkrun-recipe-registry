+def _record(level, event, text, **fields):
+    """One line in the record grammar (engine/common/log.h, frontend/src/log.rs)."""
+    now = time.time()
+    ts = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now)) + ".%03dZ" % int(now * 1000 % 1000)
+    node = os.environ.get("ANEDA_NODE_HOST") or socket.gethostname()
+    rank = os.environ.get("ANEDA_NODE_RANK") or "0"
+    quoted = text.replace("\\", "\\\\").replace('"', '\\"')
+    quoted = quoted.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
+    extra = "".join(f" {k}={v}" for k, v in fields.items())
+    print(f"ts={ts} level={level} node={node} rank={rank} src=vision event={event}{extra} "
+          f"msg=\"{quoted}\"", flush=True)
+
+
+def log(*x, event="vision.log"):
+    _record("info", event, " ".join(str(v) for v in x))
+
+
+_exit_recorded = False
+
+
+def _exit(code, text):
+    """One vision.exit record, best effort: a dead stdout must not block the exit."""
+    global _exit_recorded
+    if _exit_recorded:
+        return
+    _exit_recorded = True
+    try:
+        _record("info", "vision.exit", text, code=code)
+    except OSError:
