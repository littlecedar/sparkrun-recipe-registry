diff --git a/ds41f-4xgx10-switchless/frontend/src/log.rs b/ds41f-4xgx10-switchless/frontend/src/log.rs
new file mode 100644
index 0000000..7a59d57
--- /dev/null
+++ b/ds41f-4xgx10-switchless/frontend/src/log.rs
@@ -0,0 +1,166 @@
+//! Structured log records, one line per event. The grammar is shared with the engine (engine/common/log.h):
+//!   ts=<UTC ISO-8601 with milliseconds> level=<debug|info|warn|error|fatal> node=<host> rank=0 src=front
+//!   event=<noun.verb> [key=value]... [msg="<text>"]
+//! UTC comes from SystemTime (no chrono), the node from /proc/sys/kernel/hostname. dsfront runs on rank 0 only.
+//! DSFRONT_LOG_LEVEL gates the records (debug < info < warn < error < fatal; default info).
+
+use std::sync::LazyLock;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+enum Level {
+    Debug,
+    Info,
+    Warn,
+    Error,
+    Fatal,
+}
+
+impl Level {
+    fn as_str(self) -> &'static str {
+        match self {
+            Level::Debug => "debug",
+            Level::Info => "info",
+            Level::Warn => "warn",
+            Level::Error => "error",
+            Level::Fatal => "fatal",
+        }
+    }
+
+    fn parse(s: &str) -> Option<Level> {
+        match s {
+            "debug" => Some(Level::Debug),
+            "info" => Some(Level::Info),
+            "warn" => Some(Level::Warn),
+            "error" => Some(Level::Error),
+            "fatal" => Some(Level::Fatal),
+            _ => None,
+        }
+    }
+}
+
+/// DSFRONT_LOG_LEVEL resolved once (default info). An unknown value falls back to info and writes one
+/// warn record naming it, so a bad setting is visible, not silent.
+fn threshold() -> u8 {
+    static T: LazyLock<u8> = LazyLock::new(|| match std::env::var("DSFRONT_LOG_LEVEL") {
+        Ok(v) if !v.is_empty() => match Level::parse(&v) {
+            Some(l) => l as u8,
+            None => {
+                let msg = quote("unknown DSFRONT_LOG_LEVEL, using info");
+                emit(Level::Warn, "log.level", &[("value", v.as_str()), ("msg", msg.as_str())]);
+                Level::Info as u8
+            }
+        },
+        _ => Level::Info as u8,
+    });
+    *T
+}
+
+fn node() -> &'static str {
+    static NODE: LazyLock<String> = LazyLock::new(|| {
+        std::fs::read_to_string("/proc/sys/kernel/hostname")
+            .ok()
+            .map(|s| s.trim().to_string())
+            .filter(|s| !s.is_empty())
+            .unwrap_or_else(|| "unknown".into())
+    });
+    NODE.as_str()
+}
+
+/// Days since 1970-01-01 to (year, month, day): Howard Hinnant's civil_from_days.
+fn civil(days: i64) -> (i64, i64, i64) {
+    let z = days + 719468;
+    let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
+    let doe = z - era * 146097;
+    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = mp + (if mp < 10 { 3 } else { -9 });
+    (y + (if m <= 2 { 1 } else { 0 }), m, d)
+}
+
+/// The ungated writer: the prefix, then `fields` as key=value, then a newline.
+fn emit(level: Level, event: &str, fields: &[(&str, &str)]) {
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default();
+    let secs = now.as_secs() as i64;
+    let (y, mo, d) = civil(secs.div_euclid(86400));
+    let tod = secs.rem_euclid(86400);
+    let mut s = format!(
+        "ts={y:04}-{mo:02}-{d:02}T{:02}:{:02}:{:02}.{:03}Z level={} node={} rank=0 src=front event={event}",
+        tod / 3600,
+        tod % 3600 / 60,
+        tod % 60,
+        now.subsec_millis(),
+        level.as_str(),
+        node()
+    );
+    for (k, v) in fields {
+        s.push(' ');
+        s.push_str(k);
+        s.push('=');
+        s.push_str(v);
+    }
+    s.push('\n');
+    eprint!("{s}");
+}
+
+/// One record, gated by DSFRONT_LOG_LEVEL (values must not contain spaces; use `msg`).
+pub fn line(level: &str, event: &str, fields: &[(&str, &str)]) {
+    let l = Level::parse(level).unwrap_or(Level::Info);
+    if (l as u8) < threshold() {
+        return;
+    }
+    emit(l, event, fields);
+}
+
+/// msg="..." with quotes, backslashes and control characters escaped.
+pub fn quote(text: &str) -> String {
+    let mut q = String::with_capacity(text.len() + 2);
+    q.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => q.push_str("\\\""),
+            '\\' => q.push_str("\\\\"),
+            '\n' => q.push_str("\\n"),
+            '\t' => q.push_str("\\t"),
+            '\r' => q.push_str("\\r"),
+            _ => q.push(c),
+        }
+    }
+    q.push('"');
+    q
+}
+
+/// A record whose only payload is a message.
+pub fn msg(level: &str, event: &str, text: &str) {
+    let q = quote(text);
+    line(level, event, &[("msg", q.as_str())]);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn civil_matches_known_dates() {
+        assert_eq!(civil(0), (1970, 1, 1));
+        assert_eq!(civil(19723), (2024, 1, 1)); // leap year boundary
+        assert_eq!(civil(20692), (2026, 8, 27));
+    }
+
+    #[test]
+    fn quote_escapes_the_grammar() {
+        assert_eq!(quote("a \"b\"\nc"), "\"a \\\"b\\\"\\nc\"");
+    }
+
+    #[test]
+    fn levels_are_ordered_and_parsed() {
+        assert!(Level::Debug < Level::Info && Level::Info < Level::Warn);
+        assert!(Level::Warn < Level::Error && Level::Error < Level::Fatal);
+        assert_eq!(Level::parse("debug"), Some(Level::Debug));
+        assert_eq!(Level::parse("fatal"), Some(Level::Fatal));
+        assert_eq!(Level::parse("bogus"), None);
+    }
+}
